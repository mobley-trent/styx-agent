{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mobley-trent/styx-agent/sandbox/toolset.schema.json",
  "title": "styx sandbox toolset manifest",
  "description": "The image's own declaration at /etc/styx/toolset.json (docs/sandbox-image.md §9). schema_version 1 is the image contract: a manifest this schema does not accept is an image styx does not know how to describe.",
  "type": "object",
  "required": ["schema_version", "image_version", "base", "tools", "wordlists", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "image_version": {
      "type": "string",
      "pattern": "^sandbox-v1\\.[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "base": {
      "type": "string",
      "pattern": "^.+@sha256:[0-9a-f]{64}$"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "parser"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "parser": {
            "type": ["string", "null"],
            "enum": [
              null,
              "nmap_parse",
              "nuclei_parse",
              "sqlmap_parse",
              "gobuster_parse",
              "cme_parse",
              "bloodhound_parse"
            ]
          }
        }
      }
    },
    "wordlists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/usr/share/wordlists/styx/[a-z0-9-]+\\.txt$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "nuclei_templates",
        "semgrep_rules",
        "trivy_db",
        "trivy_java_db",
        "seclists"
      ],
      "additionalProperties": false,
      "properties": {
        "nuclei_templates": {
          "type": "string",
          "minLength": 1
        },
        "semgrep_rules": {
          "type": "string",
          "minLength": 1
        },
        "trivy_db": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "trivy_java_db": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "seclists": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
